          "eligible",
          "nonfactual",
          "ambiguous",
          "out_of_scope",
          "split_required"
        ]
      },
      "surface_form_tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "speech_act_tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "conditionality": {
        "enum": [
          "conditional",
          "unconditional",
          "unspecified"
        ]
      },
      "tag_uncertainty": {
        "type": "string"
      },
      "interpretation": {
        "type": "string"
      },
      "alternatives": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "relation_expectation": {
        "enum": [
          "supported",
          "contradicted",
          "insufficient",
          null
        ]
      },
      "deliverable_relation": {
        "enum": [
          "supported",
          "contradicted",
          "insufficient",
          null
        ]
      },
      "decision_state": {
        "enum": [
          "decided",
          "blocked",
          "abstain",
          "not_executed",
          "split"
        ]
      },
      "reason": {
        "type": "string"
      },
      "citations": {
