              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "mechanical": {
              "enum": [
                "pass",
                "fail",
                "not_evaluated"
              ]
            },
            "relevance": {
              "type": "string"
            },
            "entailment": {
              "type": "string"
            },
            "sufficiency": {
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "quote",
            "mechanical",
            "relevance",
            "entailment",
            "sufficiency"
          ],
          "additionalProperties": false
        }
