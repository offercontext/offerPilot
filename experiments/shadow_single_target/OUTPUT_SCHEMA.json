                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "relation_expectation": {
                  "enum": [
                    "supported",
                    "contradicted",
                    "insufficient",
                    null
                  ]
                },
                "deliverable_relation": {
                  "enum": [
                    "supported",
                    "contradicted",
                    "insufficient",
                    null
                  ]
                },
                "decision_state": {
                  "enum": [
                    "decided",
                    "blocked",
                    "abstain",
